# Flags override these values. Settings can be changed in the app except for
# paths and the API endpoint.

# Required: `sessionid` from a logged-in browser.
INSTAGRAM_SESSIONID=

# Select comma-separated values: posts, dms, reactions, likes, saved, comments,
# archived, reposts, or all. Leave empty to select nothing. `all` excludes
# unfollow; add that separately.
INSTAGRAM_CONTENT=

# DMs and reactions

# Thread IDs, comma-separated. Empty uses the inbox or app picks.
INSTAGRAM_THREADS=
# all, 1on1, or group. Explicit thread IDs bypass this filter.
INSTAGRAM_DM_KIND=all
# Keep text, Reels, and shared posts; unsend other messages.
INSTAGRAM_DM_MEDIA_ONLY=false
# Hide eligible threads after a live run.
INSTAGRAM_HIDE_THREADS=false
# Usernames, user IDs, or thread IDs to protect; may also be a file path.
INSTAGRAM_PROTECT=

# Filters

# YYYY-MM-DD or RFC 3339, interpreted as UTC; the bound itself is excluded.
INSTAGRAM_AFTER=
INSTAGRAM_BEFORE=
# Planned-item limit. 0 means unlimited.
INSTAGRAM_LIMIT=0

# Run

# Keep this enabled until you have reviewed the plan.
INSTAGRAM_DRY_RUN=true
# Minimum delay between delete requests: 200 ms.
INSTAGRAM_DELETE_DELAY_MS=2000
# Minimum delay between read requests: 100 ms.
INSTAGRAM_SCAN_DELAY_MS=350
# Parallel reads, from 1 to 8; divides the scan delay.
INSTAGRAM_SCAN_CONCURRENCY=4

# Paths and API endpoint

INSTAGRAM_SESSION_PATH=data/instagram/session.json
INSTAGRAM_HISTORY_DIR=./data/instagram/history
INSTAGRAM_BASE_URL=https://i.instagram.com/api/v1
