# Discord user token. Keep this file private.
DISCORD_TOKEN=
DISCORD_BASE_URL=https://discord.com/api/v9
DISCORD_SESSION_PATH=data/discord/session.json

# all, dms, guilds, none, or channels:<id>,<id>
DISCORD_SCOPE=all
DISCORD_DM_KIND=all
# all, only-attachments, has-attachments, has-links, or text-only
DISCORD_CONTENT_FILTER=all
# Set true to keep pinned messages.
DISCORD_KEEP_PINNED=false
DISCORD_BEFORE=
DISCORD_AFTER=
DISCORD_LIMIT=0

DISCORD_THROTTLE_MS=2000
DISCORD_SCAN_THROTTLE_MS=350
DISCORD_SCAN_CONCURRENCY=4
DISCORD_DRY_RUN=true
DISCORD_CLOSE_DMS=false

PRUNER_HISTORY_DIR=./data/discord/history
