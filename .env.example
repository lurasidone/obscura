# Copy this file to `.env`, add the credentials you need, and keep it private:
#   cp .env.example .env && chmod 600 .env
#
# Flags override these settings. Runs start in dry-run mode.


# Discord

# User token; private-account automation may violate Discord's Terms of Service.
DISCORD_TOKEN=
DISCORD_BASE_URL=https://discord.com/api/v9
DISCORD_SESSION_PATH=data/discord/session.json

# all, dms, guilds, none, or channels:<id>,<id>
DISCORD_SCOPE=all
DISCORD_DM_KIND=all
# all, only-attachments, has-attachments, has-links, or text-only
DISCORD_CONTENT_FILTER=all
# Set true to keep pinned messages.
DISCORD_KEEP_PINNED=false
DISCORD_BEFORE=
DISCORD_AFTER=
DISCORD_LIMIT=0

DISCORD_THROTTLE_MS=2000
DISCORD_SCAN_THROTTLE_MS=350
DISCORD_SCAN_CONCURRENCY=4
DISCORD_DRY_RUN=true
DISCORD_CLOSE_DMS=false

# Instagram

# `sessionid` cookie from a browser where you are logged in.
INSTAGRAM_SESSIONID=
INSTAGRAM_BASE_URL=https://i.instagram.com/api/v1
INSTAGRAM_SESSION_PATH=data/instagram/session.json

# posts, dms, reactions, likes, saved, comments, archived, reposts, or all.
# Add `unfollow` separately; `all` does not include it.
INSTAGRAM_CONTENT=

INSTAGRAM_THREADS=
INSTAGRAM_DM_KIND=all
INSTAGRAM_DM_MEDIA_ONLY=false
INSTAGRAM_HIDE_THREADS=false
# Usernames, user IDs, and thread IDs can be protected, or use a file.
INSTAGRAM_PROTECT=

# YYYY-MM-DD or RFC 3339, interpreted as UTC; the bound itself is excluded.
INSTAGRAM_AFTER=
INSTAGRAM_BEFORE=
INSTAGRAM_LIMIT=0

INSTAGRAM_DRY_RUN=true
INSTAGRAM_DELETE_DELAY_MS=2000
INSTAGRAM_SCAN_DELAY_MS=350
INSTAGRAM_SCAN_CONCURRENCY=4

# Paths

# Each platform has its own archive directory.
PRUNER_HISTORY_DIR=./data/discord/history
INSTAGRAM_HISTORY_DIR=./data/instagram/history
